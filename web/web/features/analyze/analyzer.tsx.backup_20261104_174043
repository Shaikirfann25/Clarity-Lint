'use client';
import {useState} from 'react';import {AlertTriangle,CheckCircle2,Clipboard,Copy,Loader2,Play,ScanText,Sparkles,Target} from 'lucide-react';
import {SectionHeader,Panel,Tag,Button,EmptyState} from '@/components/ui';import {analyzeText,Analysis} from '@/lib/api';import {Toast} from '@/components/toast';import {useToast} from '@/hooks/use-toast';
const samples=['The supplier shall provide the report soon.','The team will review the proposal with the client and send it to them.','All users must not access the portal and submit changes without approval.'];
const names:Record<string,string>={vague:'Vague language',attachment:'Attachment ambiguity',scope:'Scope ambiguity',pronoun:'Unclear reference',no_ambiguity:'No configured pattern'};
export function AnalysisWorkbench(){const [text,setText]=useState(samples[0]);const [result,setResult]=useState<Analysis|null>(null);const [loading,setLoading]=useState(false);const [tab,setTab]=useState('findings');const {message,kind,show,clear}=useToast();const count=text.trim().length;
 const run=async()=>{if(!text.trim()){show('Enter a sentence before running analysis.','error');return;}setLoading(true);try{setResult(await analyzeText(text.trim()));setTab('findings');show('Analysis completed. Review each finding in context.','success')}catch(e:any){show(e.message||'Could not reach the API.','error')}finally{setLoading(false)}};
 const copy=(value:string)=>navigator.clipboard.writeText(value).then(()=>show('Copied to clipboard.','success')).catch(()=>show('Clipboard permission unavailable.','error'));
 const detections=result?.detections||[];
 return <div className="page-stack"><SectionHeader eyebrow="LANGUAGE INTELLIGENCE / 01" title="Analyze text" description="Inspect one sentence at a time. Every result is a review prompt—not a legal or contractual verdict." actions={<Tag tone="info">Single-sentence workflow</Tag>}/><div className="analyzer-layout"><div className="analyzer-main"><Panel title="Text input" subtitle="Paste a clause, requirement or policy sentence" action={<span className="field-count">{count} characters</span>}><textarea className="analysis-input" value={text} onChange={e=>setText(e.target.value)} placeholder="Enter the sentence you want to review..." maxLength={5000}/><div className="input-toolbar"><div className="sample-picks"><span>Try a sample</span>{samples.map((s,i)=><button key={i} onClick={()=>setText(s)}>0{i+1}</button>)}</div><Button onClick={run} disabled={loading||!text.trim()}>{loading?<Loader2 className="spin" size={16}/>:<Play size={16}/>} {loading?'Analyzing…':'Run analysis'}</Button></div></Panel>
 <Panel title="Analysis output" subtitle="Evidence and alternative readings from the connected pipeline"><div className="result-tabs">{[['findings','Findings'],['readings','Readings'],['rewrites','Rewrite ideas'],['raw','Run details']].map(([id,label])=><button key={id} className={tab===id?'selected':''} onClick={()=>setTab(id)}>{label}{id==='findings'&&<span>{detections.length}</span>}</button>)}</div>
 {!result?<EmptyState icon={ScanText} title="Waiting for your first analysis" description="Run the analyzer to see flagged spans, explanations and possible interpretations."/>:tab==='findings'?<div className="finding-list">{detections.length?detections.map((d,i)=><div className="finding-card" key={i}><div className="finding-top"><Tag tone={d.label==='vague'?'warning':'gold'}>{names[d.label]||d.label}</Tag><span className="finding-source">{d.source||'rules'}</span></div><div className="evidence-quote">“{d.span||'Evidence span unavailable'}”</div><p>{d.reason||'Review this phrase in context.'}</p>{d.confidence!==null&&d.confidence!==undefined&&<div className="confidence-row"><span>Model confidence</span><b>{Math.round(d.confidence*100)}%</b></div>}</div>):<div className="clean-result"><CheckCircle2 size={24}/><b>No configured pattern flagged this sentence.</b><span>This does not prove it is unambiguous. Review the surrounding context and intended meaning.</span></div>}</div>:tab==='readings'?<div className="reading-list">{result.readings.length?result.readings.map((r,i)=><div className="reading-card" key={i}><span>0{i+1}</span><p>{r}</p></div>):<EmptyState icon={Target} title="No alternative readings returned" description="The current pipeline did not provide competing interpretations."/></div>:tab==='rewrites'?<div className="reading-list">{result.rewrites.length?result.rewrites.map((r,i)=><div className="rewrite-card" key={i}><div><span>OPTION 0{i+1}</span><p>{r}</p></div><button onClick={()=>copy(r)}><Copy size={15}/> Copy</button></div>):<EmptyState icon={Sparkles} title="No rewrite suggestions" description="Confirm the intended meaning before changing wording."/></div>:<div className="run-details"><div><span>Execution mode</span><Tag tone={result.mode==='demo_fallback'?'warning':'success'}>{result.mode}</Tag></div><div><span>Latency</span><b>{Number(result.latency_ms||0).toFixed(2)} ms</b></div><div><span>Model predictions</span><b>{result.model_predictions?.length||0}</b></div><div><span>Detections</span><b>{detections.length}</b></div><p>Demo fallback results are heuristic examples, not validated model outputs.</p><Button variant="secondary" onClick={()=>copy(JSON.stringify(result,null,2))}><Clipboard size={15}/> Copy JSON response</Button></div>}</Panel></div>
 <aside className="analyzer-side"><Panel title="Review guide" subtitle="What to look for">{[['dot-amber','Vague language','Could different readers apply different thresholds or deadlines?'],['dot-violet','Attachment','Could a phrase modify more than one part of the sentence?'],['dot-blue','Scope','Is it clear which actions, people or conditions a modifier covers?'],['dot-green','Reference','Can each pronoun be tied to one intended entity?']].map(([dot,title,desc])=><div className="guide-item" key={title}><span className={`guide-dot ${dot}`}/><div><b>{title}</b><p>{desc}</p></div></div>)}</Panel><Panel title="Session summary"><div className="summary-number">{detections.length.toString().padStart(2,'0')}</div><span className="summary-label">Potential findings</span><div className="soft-divider"/><div className="system-detail"><span>Input size</span><b>{count} chars</b></div><div className="system-detail"><span>Last run</span><b>{result?'Completed':'Not started'}</b></div><div className="system-detail"><span>Mode</span><b>{result?.mode==='demo_fallback'?'Demo fallback':result?'Connected':'—'}</b></div></Panel><div className="notice-card"><AlertTriangle size={17}/><p>Use findings as prompts for human review. Do not treat a low finding count as proof of correctness.</p></div></aside></div><Toast message={message} kind={kind} onClose={clear}/></div>
}
